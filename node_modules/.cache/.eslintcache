   <img src={item.photo} alt=\"\" height=\"200\" width=\"200\" />\n          <div>Name: {item.name}</div>\n          <div>Color: {item.color}</div>\n          <div>Brand: {item.brand}</div>\n          <div>Price: {item.price}</div>\n          <div>Category: {item.category}</div>\n          <div><button onClick={() => dispatch(addToCart(item))} >Add</button> <button onClick={() => dispatch(removeToCart(item.id))}>Remove</button>  </div>\n        </div>)\n\n      }\n\n    </div>\n\n  </>)\n}\n\nexport default App;\n","C:\\Users\\Dell\\Desktop\\fb\\src\\redux\\store\\store.js",[],[],"C:\\Users\\Dell\\Desktop\\fb\\src\\context\\Cart.js",[],[],"C:\\Users\\Dell\\Desktop\\fb\\src\\redux\\action\\productAction.js",[],[],"C:\\Users\\Dell\\Desktop\\fb\\src\\redux\\action\\add_to_cart.js",[],[],"C:\\Users\\Dell\\Desktop\\fb\\src\\components\\context\\item.js",[],[],"C:\\Users\\Dell\\Desktop\\fb\\src\\pages\\home\\Home.js",["212"],[],"C:\\Users\\Dell\\Desktop\\fb\\src\\components\\context\\Cart.js",[],[],"C:\\Users\\Dell\\Desktop\\fb\\src\\redux\\reducer\\rootReducer.js",[],[],"C:\\Users\\Dell\\Desktop\\fb\\src\\redux\\saga\\productSaga.js",[],[],"C:\\Users\\Dell\\Desktop\\fb\\src\\redux\\constant.js",[],[],"C:\\Users\\Dell\\Desktop\\fb\\src\\components\\ctemp\\ctemp.js",[],[],"C:\\Users\\Dell\\Desktop\\fb\\src\\components\\topbar\\topbar.js",[],[],"C:\\Users\\Dell\\Desktop\\fb\\src\\components\\bottombar\\bottombar.js",[],[],"C:\\Users\\Dell\\Desktop\\fb\\src\\redux\\reducer\\productReducer.js",[],[],"C:\\Users\\Dell\\Desktop\\fb\\src\\redux\\reducer\\reducer.js",[],[],"C:\\Users\\Dell\\Desktop\\fb\\src\\pages\\contactus\\Contactus.js",["213","214","215"],[],"C:\\Users\\Dell\\Desktop\\fb\\src\\pages\\cart\\cart.js",[],[],"C:\\Users\\Dell\\Desktop\\fb\\src\\pages\\users\\users.js",["216"],[],"C:\\Users\\Dell\\Desktop\\fb\\src\\pages\\aboutus\\Aboutus.js",[],[],"C:\\Users\\Dell\\Desktop\\fb\\src\\pages\\searchproduct\\sproduct.js",["217","218","219","220","221"],[],"C:\\Users\\D